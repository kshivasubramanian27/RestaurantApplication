@model RestaurantApplicationUI.DTO.Exception.ExceptionInfo

@{
    Layout = null;
    ViewData["Title"] = "Application Error";
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>Application Error</title>

        <link href="~/BootstrapCSS/bootstrap.min.css" rel="stylesheet" />
    </head>

    <body>
        <div class="container mt-5">
            <div class="card shadow">

                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">An error occurred</h3>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <strong>Status Code:</strong>
                        <span>@Model.StatusCode</span>
                    </div>

                    <div class="mb-3">
                        <strong>Error Message:</strong>
                        <p class="mt-2">@Model.ErrorMessage</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ControllerName))
                    {
                        <div class="mb-3">
                            <strong>Request Path:</strong>
                            <p class="mt-2">@Model.ControllerName</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.StackTrace))
                    {
                        <div class="mb-3">
                            <strong>Stack Trace (Development Only):</strong>

                            <pre class="bg-light p-3 mt-2"
                                 style="white-space: pre-wrap; overflow-wrap: anywhere;">@Model.StackTrace</pre>
                        </div>
                    }

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-primary">
                        Back to Dashboard
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-secondary ms-2">
                        Back to Login
                    </a>

                </div>
            </div>
        </div>
    </body>
</html>