@model RestaurantApplicationUI.DTO.Roles.EditUserPermissionDTO

@{
    ViewData["Title"] = "Edit User Permission";
    ViewBag.ActiveMenuLink = "RolesAndPermissions";
}

<link href="~/BootstrapCSS/breadcrumbs.css" rel="stylesheet" />

<div class="container my-2">

     
    <nav aria-label="breadcrumb">

        <ol class="breadcrumb breadcrumb-chevron p-3 bg-body-tertiary border rounded-3">

            <li class="breadcrumb-item">
                <a class="link-body-emphasis fw-semibold text-decoration-none"
                   href="/Dashboard">
                    <i class="bi bi-house"></i>
                </a>
            </li>

            <li class="breadcrumb-item">
                <a class="link-body-emphasis fw-semibold text-decoration-none"
                   asp-controller="RolesAndPermissions"
                   asp-action="Index">
                    Roles And Permissions
                </a>
            </li>

            <li class="breadcrumb-item active"
                aria-current="page">
                Edit User Permission
            </li>

        </ol>

    </nav>

     
</div>

<div class="container-fluid">

     
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Edit User Permission</h2>

            <p class="text-muted mb-0">
                Edit Permission with {ModuleName.PermissionName}
            </p>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="RolesAndPermissions"
                  asp-action="EditPermission"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>

                <h5 class="mb-3">
                    <i class="bi bi-building-up me-2"></i>
                    Permission Details
                </h5>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               autocomplete="Name" required />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <h5 class="mb-3 mt-3">
                    <i class="bi bi-chat-left me-2"></i>
                    Description
                </h5>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="RolesAndPermissions"
                       asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-person-plus me-1"></i>
                        Update

                    </button>

                </div>

            </form>

        </div>

    </div>

     
</div>