@using RestaurantApplicationUI.DTO.Roles

@{
    var allRoles = ViewBag.allRoles as IList<UserRolesDTO> ?? new List<UserRolesDTO>();
    var allPermissions = ViewBag.allPermissions as IList<UserPermissionsDTO> ?? new List<UserPermissionsDTO>();
}

<link href="~/BootstrapCSS/breadcrumbs.css" rel="stylesheet" />

<div class="container my-2">
    <nav aria-label="breadcrumb">

        <ol class="breadcrumb breadcrumb-chevron p-3 bg-body-tertiary border rounded-3">

            <li class="breadcrumb-item">
                <a class="link-body-emphasis fw-semibold text-decoration-none" href="/Dashboard">
                    <i class="bi bi-house" width="16" height="16"></i>
                </a>
            </li>

            <li class="breadcrumb-item">
                <a class="link-body-emphasis fw-semibold text-decoration-none"
                   href="#">User Roles & Permissions</a>
            </li>

        </ol>
    </nav>
</div>

<div class="container-fluid">

    <div class="justify-content align-items-center mb-4">
        <div>
            <h2 class="mb-1"></h2>
        </div>
            
            <a asp-controller="RolesAndPermissions" asp-action="AddRole" class="btn btn-primary">
                <i class="bi bi-buildings-fill me-2"></i>
                Add Role
            </a>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Role</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var role in allRoles)
                        {
                            <tr>
                                <td>
                                    <strong>@role.RoleName</strong>
                                </td>

                                <td>
                                    @role.RoleDescrption
                                </td>

                                <td class="text-end">
                                        <a asp-controller="RolesAndPermissions"
                                            asp-action="EditPermissions"
                                            asp-route-id="@role.Id"
                                            class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div><br />

<div class="container-fluid">

    <div class="justify-content align-items-center mb-4">
        <div>
            <h2 class="mb-1"></h2>
        </div>

            <a asp-controller="RolesAndPermissions" asp-action="AddPermissions" class="btn btn-primary">
                <i class="bi bi-building-fill-add me-2"></i>
                Add Permissions
            </a>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Permission Name</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var permission in allPermissions)
                        {
                            <tr>
                                <td>
                                    <strong>@permission.Name</strong>
                                </td>

                                <td>
                                    @permission.Description
                                </td>

                                <td class="text-end">
                                        <a asp-controller="RolesAndPermissions"
                                            asp-action="EditPermissions"
                                       asp-route-id="@permission.Id"
                                            class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>