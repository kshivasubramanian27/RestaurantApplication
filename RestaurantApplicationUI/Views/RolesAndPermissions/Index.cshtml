@using System.Security.Claims
@using RestaurantApplicationUI.DTO.Roles
@using RestaurantApplicationUI.Utilities

@{
    ViewData["Title"] = "Roles And Permissions";
    ViewBag.ActiveMenuLink = "RolesAndPermissions";

    var allRoles = ViewBag.allRoles as IList<UserRolesDTO> ?? new List<UserRolesDTO>();
    var allPermissions = ViewBag.allPermissions as IList<UserPermissionsDTO> ?? new List<UserPermissionsDTO>();

    var currentRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var currentRoleLevel = RoleHierarchy.RoleHierarchyDict.GetValueOrDefault(currentRole, 0);
}

<link href="~/BootstrapCSS/breadcrumbs.css" rel="stylesheet" />

<div class="container my-2">
    <nav aria-label="breadcrumb">

        <ol class="breadcrumb breadcrumb-chevron p-3 bg-body-tertiary border rounded-3">

            <li class="breadcrumb-item">
                <a class="link-body-emphasis fw-semibold text-decoration-none" href="/Dashboard">
                    <i class="bi bi-house" width="16" height="16"></i>
                </a>
            </li>

            <li class="breadcrumb-item">
                <a class="link-body-emphasis fw-semibold text-decoration-none"
                   href="#">User Roles & Permissions</a>
            </li>

        </ol>
    </nav>
</div>

<div class="container-fluid">

    @if (ViewBag.CreatePermissionError != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.CreatePermissionError
        </div>
    }

    @if (ViewBag.DeleteRoleErrorDetails != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @ViewBag.DeleteRoleError

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="justify-content align-items-center mb-4">
        <div>
            <h2 class="mb-1"></h2>
        </div>
            
            <a asp-controller="RolesAndPermissions" asp-action="AddRole" class="btn btn-primary">
                <i class="bi bi-buildings-fill me-2"></i>
                Add Role
            </a>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Role</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var role in allRoles)
                        {
                            var targetRoleLevel = RoleHierarchy.RoleHierarchyDict.GetValueOrDefault(role.RoleName, 0);
                            var isSameRole = string.Equals(currentRole, role.RoleName, StringComparison.OrdinalIgnoreCase);
                            var canDeleteRole = !isSameRole && targetRoleLevel > 0 && currentRoleLevel > targetRoleLevel;

                            <tr>
                                <td>
                                    <strong>@role.RoleName</strong>
                                </td>

                                <td>
                                    @role.RoleDescrption
                                </td>

                                <td class="text-end">
                                    <a asp-controller="RolesAndPermissions"
                                       asp-action="EditRole"
                                       asp-route-id="@role.Id"
                                       class="btn btn-sm btn-outline-primary me-1"
                                       title="Edit Role">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (canDeleteRole)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete Role"
                                                onclick="openRoleDeleteModal(
                                            '@role.Id',
                                            '@role.RoleName')">

                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div><br />

<div class="container-fluid">

    <div class="justify-content align-items-center mb-4">
        <div>
            <h2 class="mb-1"></h2>
        </div>

            <a asp-controller="RolesAndPermissions" asp-action="AddPermissions" class="btn btn-primary">
                <i class="bi bi-building-fill-add me-2"></i>
                Add Permissions
            </a>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Permission Name</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var permission in allPermissions)
                        {
                            <tr>
                                <td>
                                    <strong>@permission.Name</strong>
                                </td>

                                <td>
                                    @permission.Description
                                </td>

                                <td class="text-end">

                                        <a asp-controller="RolesAndPermissions"
                                            asp-action="EditPermission"
                                       asp-route-id="@permission.Id"
                                            class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="openPermissionDeleteModal('@permission.Id', '@permission.Name')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<div class="modal fade" id="deleteUserPermission" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteUserModalLabel">
                    Confirm Delete
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                Are you sure you want to permanently delete this Permission:
                <strong id="permissionName"></strong>?
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <a href="#"
                   class="btn btn-danger"
                   id="confirmPermissionDeleteButton">
                    Delete
                </a>

            </div>

        </div>
    </div>
</div>

<div class="modal fade"
     id="deleteUserRole"
     tabindex="-1"
     aria-labelledby="deleteRoleModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteRoleModalLabel">
                    Confirm Role Deletion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p>
                    Are you sure you want to permanently delete
                    the role <strong id="roleName"></strong>?
                </p>

                <div class="alert alert-warning" role="alert">
                    <strong>Warning:</strong>
                    This action cannot be undone. Users associated
                    with this role must be manually reassigned to
                    another role before deletion.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-controller="RolesAndPermissions"
                      asp-action="DeleteRole"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deleteRoleId" />

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Delete Permanently
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>

    function openPermissionDeleteModal(permissionId, permissionName) {

        document.getElementById("permissionName").textContent = permissionName;

        document.getElementById("confirmPermissionDeleteButton").href = "/RolesAndPermissions/DeletePermission/" + permissionId;

        const modal = new bootstrap.Modal(document.getElementById("deleteUserPermission"));

        modal.show();
    }

    function openRoleDeleteModal(roleId, roleName) {

        document.getElementById("roleName").textContent = roleName;

        document.getElementById("deleteRoleId").value = roleId;

        const modal = new bootstrap.Modal(document.getElementById("deleteUserRole"));

        modal.show();
    }

</script>